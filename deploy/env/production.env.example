# Copy to production.env on the server. Do not commit secrets.
# AME_VERSION is used by Compose interpolation (image tag), not only the
# container. Pass the same file with --env-file:
#   docker compose --env-file deploy/env/production.env -f deploy/docker/docker-compose.prod.yml up -d
#
# Replace YOUR_ORG in deploy/docker/docker-compose.prod.yml before first pull.
# Do not use latest. C19 publishes 0.10.0 and git-<sha> tags.

AME_VERSION=0.10.0

DASHSCOPE_API_KEY=
BAILIAN_WORKSPACE_ID=
BAILIAN_REGION=cn-beijing

# qwen | mock — production should be qwen.
EMBEDDING_PROVIDER=qwen
RERANKER_PROVIDER=qwen
EMBEDDING_DIM=1024

# Compose overrides these inside the container:
#   MEMORY_DB_PATH=/data/lance
#   LOG_DIR=/app/logs
# Never point mock (32-dim) at the same LanceDB volume as qwen (1024-dim).

# Current Caddyfile (deploy/caddy/Caddyfile) listens on :80 only.
# A public hostname and certificates are a later change, not this file.
