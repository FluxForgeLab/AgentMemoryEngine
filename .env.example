# Copy to .env and fill in real values. Do not commit .env.

# --- Stage 5-8 / Qwen3-VL (examples/01, 02) ---
DASHSCOPE_API_KEY=sk-xxxxxxxx
BAILIAN_WORKSPACE_ID=llm-xxxxxxxx
BAILIAN_REGION=cn-beijing
# BAILIAN_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1
QWEN_VL_EMBEDDING_MODEL=qwen3-vl-embedding
QWEN_VL_EMBEDDING_DIMENSION=1024
QWEN_VL_RERANK_MODEL=qwen3-vl-rerank

# --- Stage 9/10 HTTP + Harness ---
MEMORY_DB_PATH=./database/lance
MEMORY_TABLE_NAME=service_memories

# qwen | mock
# 默认接入百炼 qwen3-vl-embedding（与 02 相同）。单测切 mock。
EMBEDDING_PROVIDER=qwen
RERANKER_PROVIDER=qwen

EMBEDDING_DIM=1024

# --- CLI LLM (python -m app.cli) ---
LLM_PROVIDER=deepseek
LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# Kimi / K3（thinking 模型不要手设 temperature，适配器会省略）:
# LLM_PROVIDER=kimi
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=kimi-k3
# 国际站密钥改用 https://api.moonshot.ai/v1

# LOG_DIR=./logs
# AME_LOG_DISABLED=0

